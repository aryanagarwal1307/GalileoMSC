# Closed triangular prism used as the static ramp collision and visual mesh.
# Vertices are unchanged from the original asset so the PyBullet convex hull is
# unchanged. Faces are triangles with consistent outward-facing flat normals.
v 0.000000 0.000000 0.000000
v 1.000000 0.000000 0.000000
v 1.000000 1.000000 0.000000
v 0.000000 1.000000 0.000000
v 0.000000 0.000000 1.000000
v 0.000000 1.000000 1.000000

vn 0.000000 0.000000 -1.000000
vn -1.000000 0.000000 0.000000
vn 0.707107 0.000000 0.707107
vn 0.000000 -1.000000 0.000000
vn 0.000000 1.000000 0.000000

s off

# Bottom (-Z)
f 1//1 4//1 3//1
f 1//1 3//1 2//1

# Vertical end (-X)
f 1//2 5//2 6//2
f 1//2 6//2 4//2

# Sloped surface (+X, +Z)
f 2//3 3//3 6//3
f 2//3 6//3 5//3

# Front and back caps (-Y, +Y)
f 1//4 2//4 5//4
f 4//5 6//5 3//5
